<?xml version="1.0" encoding="utf-8"?>
<carbon.widget.RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg"
    android:fitsSystemWindows="true"
    tools:context=".activity.ProductDetailActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="420dp">

                <carbon.widget.ImageView
                    android:id="@+id/imgMain"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F2ECE6"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-28dp"
                android:background="@drawable/bg_detail_sheet"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="28dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvThumbs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <carbon.widget.TextView
                        android:id="@+id/tvBrand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="adikala.in"
                        android:textColor="@color/teal"
                        android:textSize="14sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <carbon.widget.ImageView
                        android:id="@+id/btnShare"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@color/white"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="9dp"
                        android:src="@drawable/ic_share"
                        app:carbon_cornerRadius="19dp"
                        app:carbon_elevation="2dp"
                        app:carbon_rippleColor="#1A0D3238"
                        app:carbon_stroke="#e9bdb0"
                        app:carbon_strokeWidth="1.5dp"
                        app:carbon_tint="#0D3238" />
                </LinearLayout>

                <carbon.widget.TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Peacock printed MDF Cutout Pack of 4"
                    android:textColor="#0D3238"
                    android:textSize="22sp"
                    app:carbon_font="@font/space_grotesk_semibold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#E7F0EA"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    app:carbon_cornerRadius="11dp">

                    <carbon.widget.ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_star"
                        app:carbon_tint="#F5A623" />

                    <carbon.widget.TextView
                        android:id="@+id/tvRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="4.8 · No reviews yet"
                        android:textColor="#4A6B5A"
                        android:textSize="13sp"
                        app:carbon_font="@font/space_grotesk_semibold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <carbon.widget.TextView
                        android:id="@+id/tvDiscountedPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹349"
                        android:textColor="#0D3238"
                        android:textSize="30sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <carbon.widget.TextView
                        android:id="@+id/tvActualPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="₹399"
                        android:textColor="#9B9B9B"
                        android:textSize="16sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <carbon.widget.TextView
                        android:id="@+id/tvSave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="#C97B4A"
                        android:paddingStart="9dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="4dp"
                        android:text="Save ₹50"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:carbon_cornerRadius="9dp"
                        app:carbon_font="@font/space_grotesk_semibold" />
                </LinearLayout>

                <carbon.widget.TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tax included. Shipping calculated at checkout."
                    android:textColor="@color/carbon_grey_700"
                    android:textSize="12sp"
                    app:carbon_font="@font/space_grotesk_semibold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="#F7F2ED"
                    android:orientation="vertical"
                    android:padding="16dp"
                    app:carbon_cornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <carbon.widget.ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_verified"
                            app:carbon_tint="#0D3238" />

                        <carbon.widget.TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="100% Hand crafted · Made in India"
                            android:textColor="#0D3238"
                            android:textSize="14sp"
                            app:carbon_font="@font/space_grotesk_semibold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <carbon.widget.ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_truck"
                            app:carbon_tint="#0D3238" />

                        <carbon.widget.TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Free shipping above ₹1499 · COD available"
                            android:textColor="#0D3238"
                            android:textSize="14sp"
                            app:carbon_font="@font/space_grotesk_semibold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <carbon.widget.ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lock"
                            app:carbon_tint="#0D3238" />

                        <carbon.widget.TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Secure payments"
                            android:textColor="#0D3238"
                            android:textSize="14sp"
                            app:carbon_font="@font/space_grotesk_semibold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <carbon.widget.TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quantity"
                        android:textColor="#0D3238"
                        android:textSize="18sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:background="@color/white"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:carbon_cornerRadius="23dp"
                        app:carbon_stroke="#e9bdb0"
                        app:carbon_strokeWidth="1.5dp">

                        <carbon.widget.ImageView
                            android:id="@+id/btnMinus"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="14dp"
                            android:src="@drawable/ic_minus"
                            app:carbon_cornerRadius="23dp"
                            app:carbon_rippleColor="#1A0D3238"
                            app:carbon_tint="#0D3238" />

                        <carbon.widget.TextView
                            android:id="@+id/tvQty"
                            android:layout_width="34dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="#0D3238"
                            android:textSize="18sp"
                            app:carbon_font="@font/space_grotesk_semibold" />

                        <carbon.widget.ImageView
                            android:id="@+id/btnPlus"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="14dp"
                            android:src="@drawable/ic_plus"
                            app:carbon_cornerRadius="23dp"
                            app:carbon_rippleColor="#1A0D3238"
                            app:carbon_tint="#0D3238" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/headerDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="18dp">

                    <carbon.widget.TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Description"
                        android:textColor="#0D3238"
                        android:textSize="19sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <carbon.widget.ImageView
                        android:id="@+id/chevDesc"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        app:carbon_tint="#0D3238" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="6dp">

                    <carbon.widget.TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="Description text"
                        android:textColor="#5C5C5C"
                        android:textSize="15sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <LinearLayout
                        android:id="@+id/featureContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/headerShip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="18dp">

                    <carbon.widget.TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Shipping information"
                        android:textColor="#0D3238"
                        android:textSize="19sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <carbon.widget.ImageView
                        android:id="@+id/chevShip"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        app:carbon_tint="#0D3238" />
                </LinearLayout>

                <carbon.widget.TextView
                    android:id="@+id/contentShip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="5dp"
                    android:paddingBottom="10dp"
                    android:text="• Next-day dispatch after order confirmation\n• Free shipping above ₹1499 (not on custom orders)\n• COD available till ₹1999 · flat ₹80\n• Prepaid orders till ₹1499 · flat ₹40 shipping"
                    android:textColor="#5C5C5C"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:carbon_font="@font/space_grotesk_semibold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/headerOffers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="18dp">

                    <carbon.widget.TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Offers &amp; discounts"
                        android:textColor="#0D3238"
                        android:textSize="19sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <carbon.widget.ImageView
                        android:id="@+id/chevOffers"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        app:carbon_tint="#0D3238" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentOffers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="6dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/discountContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <carbon.widget.TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tap a code to copy"
                        android:textColor="@color/carbon_grey_700"
                        android:textSize="12sp"
                        app:carbon_font="@font/space_grotesk_semibold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/headerBulk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="18dp">

                    <carbon.widget.TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bulk &amp; custom orders"
                        android:textColor="#0D3238"
                        android:textSize="19sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <carbon.widget.ImageView
                        android:id="@+id/chevBulk"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        app:carbon_tint="#0D3238" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentBulk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="10dp"
                    android:visibility="gone">

                    <carbon.widget.TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="Buy more, save more. Custom &amp; bulk pricing available — reach our team, Mon–Sat 10am–7pm."
                        android:textColor="#5C5C5C"
                        android:textSize="14sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <carbon.widget.LinearLayout
                            android:id="@+id/btnCall"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:background="@color/white"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            app:carbon_cornerRadius="23dp"
                            app:carbon_rippleColor="#1A0D3238"
                            app:carbon_stroke="#0D3238"
                            app:carbon_strokeWidth="1.5dp">

                            <carbon.widget.ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_phone"
                                app:carbon_tint="#0D3238" />

                            <carbon.widget.TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Call"
                                android:textColor="#0D3238"
                                android:textSize="15sp"
                                app:carbon_font="@font/space_grotesk_semibold" />
                        </carbon.widget.LinearLayout>

                        <carbon.widget.LinearLayout
                            android:id="@+id/btnWhatsapp"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:background="#0D3238"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            app:carbon_cornerRadius="23dp"
                            app:carbon_rippleColor="#40FFFFFF">

                            <carbon.widget.ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_whatsapp"
                                app:carbon_tint="@color/white" />

                            <carbon.widget.TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="WhatsApp"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                app:carbon_font="@font/space_grotesk_semibold" />
                        </carbon.widget.LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/headerAsk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="18dp">

                    <carbon.widget.TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ask a question"
                        android:textColor="#0D3238"
                        android:textSize="19sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <carbon.widget.ImageView
                        android:id="@+id/chevAsk"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        app:carbon_tint="#0D3238" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentAsk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="6dp"
                    android:visibility="gone">

                    <carbon.widget.EditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@color/white"
                        android:gravity="center_vertical"
                        android:hint="Name"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:paddingHorizontal="16dp"
                        android:textColor="#0D3238"
                        android:textColorHint="#8A8A8A"
                        android:textSize="15sp"
                        app:carbon_cornerRadius="14dp"
                        app:carbon_font="@font/space_grotesk_semibold"
                        app:carbon_stroke="#e9bdb0"
                        app:carbon_strokeWidth="1.5dp" />

                    <carbon.widget.EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/white"
                        android:gravity="center_vertical"
                        android:hint="Email"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:paddingHorizontal="16dp"
                        android:textColor="#0D3238"
                        android:textColorHint="#8A8A8A"
                        android:textSize="15sp"
                        app:carbon_cornerRadius="14dp"
                        app:carbon_font="@font/space_grotesk_semibold"
                        app:carbon_stroke="#e9bdb0"
                        app:carbon_strokeWidth="1.5dp" />

                    <carbon.widget.EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/white"
                        android:gravity="center_vertical"
                        android:hint="Phone number"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:paddingHorizontal="16dp"
                        android:textColor="#0D3238"
                        android:textColorHint="#8A8A8A"
                        android:textSize="15sp"
                        app:carbon_cornerRadius="14dp"
                        app:carbon_font="@font/space_grotesk_semibold"
                        app:carbon_stroke="#e9bdb0"
                        app:carbon_strokeWidth="1.5dp" />

                    <carbon.widget.EditText
                        android:id="@+id/etMessage"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/white"
                        android:gravity="top|start"
                        android:hint="Message"
                        android:inputType="textMultiLine"
                        android:padding="16dp"
                        android:textColor="#0D3238"
                        android:textColorHint="#8A8A8A"
                        android:textSize="15sp"
                        app:carbon_cornerRadius="14dp"
                        app:carbon_font="@font/space_grotesk_semibold"
                        app:carbon_stroke="#e9bdb0"
                        app:carbon_strokeWidth="1.5dp" />

                    <carbon.widget.LinearLayout
                        android:id="@+id/btnSubmitQuery"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:background="#0D3238"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        app:carbon_cornerRadius="26dp"
                        app:carbon_elevation="4dp"
                        app:carbon_rippleColor="#40FFFFFF">

                        <carbon.widget.TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Send message"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            app:carbon_font="@font/space_grotesk_semibold" />
                    </carbon.widget.LinearLayout>

                    <carbon.widget.TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="Protected by hCaptcha · Privacy &amp; Terms apply"
                        android:textColor="#B6A89F"
                        android:textSize="11sp"
                        app:carbon_font="@font/space_grotesk_semibold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <carbon.widget.LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:carbon_cornerRadius="26dp"
        app:carbon_elevation="16dp"
        app:carbon_elevationShadowColor="@color/carbon_grey_500">

        <carbon.widget.LinearLayout
            android:id="@+id/btnAddToCart"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            app:carbon_cornerRadius="26dp"
            app:carbon_rippleColor="#1A0D3238"
            app:carbon_stroke="#0D3238"
            app:carbon_strokeWidth="1.5dp">

            <carbon.widget.TextView
                android:id="@+id/tvAddToCart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add to cart"
                android:textColor="#0D3238"
                android:textSize="16sp"
                app:carbon_font="@font/space_grotesk_semibold" />
        </carbon.widget.LinearLayout>

        <carbon.widget.LinearLayout
            android:id="@+id/btnBuyNow"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="#0D3238"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            app:carbon_cornerRadius="26dp"
            app:carbon_elevation="4dp"
            app:carbon_rippleColor="#40FFFFFF">

            <carbon.widget.TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buy it now"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:carbon_font="@font/space_grotesk_semibold" />
        </carbon.widget.LinearLayout>
    </carbon.widget.LinearLayout>

    <carbon.widget.ImageView
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:background="@color/white"
        android:clickable="true"
        android:focusable="true"
        android:padding="11dp"
        android:src="@drawable/ic_chevron_left"
        app:carbon_cornerRadius="22dp"
        app:carbon_elevation="6dp"
        app:carbon_rippleColor="#1A0D3238"
        app:carbon_tint="#0D3238" />

    <carbon.widget.ImageView
        android:id="@+id/btnWishlist"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:background="@color/white"
        android:clickable="true"
        android:focusable="true"
        android:padding="11dp"
        android:src="@drawable/ic_heart"
        app:carbon_cornerRadius="22dp"
        app:carbon_elevation="6dp"
        app:carbon_rippleColor="#1A0D3238"
        app:carbon_tint="#0D3238" />

</carbon.widget.RelativeLayout>