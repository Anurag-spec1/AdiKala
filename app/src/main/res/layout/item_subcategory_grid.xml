<?xml version="1.0" encoding="utf-8"?>
<carbon.widget.LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSub"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp"
    android:stateListAnimator="@null"
    app:carbon_cornerRadius="20dp"
    app:carbon_elevation="6dp"
    app:carbon_elevationShadowColor="@color/carbon_grey_500"
    app:carbon_rippleColor="#1A0D3238"
    app:carbon_stroke="#12000000"
    app:carbon_strokeWidth="1dp">

    <carbon.widget.ImageView
        android:id="@+id/ivSub"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:background="#0D3B3E"
        android:scaleType="centerCrop"
        app:carbon_cornerRadius="15dp" />

    <carbon.widget.TextView
        android:id="@+id/tvSubName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Toran"
        android:textColor="#0D3238"
        android:textSize="15sp"
        app:carbon_font="@font/space_grotesk_semibold" />

    <carbon.widget.TextView
        android:id="@+id/tvSubItems"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="4dp"
        android:text="12 items"
        android:textColor="@color/carbon_grey_700"
        android:textSize="12sp"
        app:carbon_font="@font/space_grotesk_semibold" />

</carbon.widget.LinearLayout>