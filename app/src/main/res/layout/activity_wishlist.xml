<?xml version="1.0" encoding="utf-8"?>
<carbon.widget.RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg"
    android:fitsSystemWindows="true"
    tools:context=".view.activity.WishlistActivity">

    <carbon.widget.ImageView
        android:id="@+id/btnBack"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        android:background="@color/white"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chevron_left"
        app:carbon_cornerRadius="22.5dp"
        app:carbon_elevation="4dp"
        app:carbon_rippleColor="#1A0D3238"
        app:carbon_stroke="#14000000"
        app:carbon_strokeWidth="1dp"
        app:carbon_tint="#0D3238" />

    <LinearLayout
        android:id="@+id/titleWrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_alignTop="@id/btnBack"
        android:layout_alignBottom="@id/btnBack"
        android:layout_marginStart="14dp"
        android:layout_toEndOf="@id/btnBack"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <carbon.widget.TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your"
            android:textColor="@color/carbon_grey_700"
            android:textSize="13sp"
            app:carbon_font="@font/space_grotesk_semibold" />

        <carbon.widget.TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-3dp"
            android:text="Wishlist"
            android:textColor="#0D3238"
            android:textSize="22sp"
            app:carbon_font="@font/space_grotesk_semibold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/subBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnBack"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <carbon.widget.TextView
            android:id="@+id/tvCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 items"
            android:layout_marginVertical="8dp"
            android:textColor="@color/carbon_grey_700"
            android:textSize="15sp"
            app:carbon_font="@font/space_grotesk_semibold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/subBar"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="4dp"
        android:paddingBottom="24dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWishlist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone"
            tools:listitem="@layout/item_products" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <carbon.widget.ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:alpha="0.5"
            android:src="@drawable/ic_heart"
            app:carbon_tint="@color/carbon_grey_500" />

        <carbon.widget.TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Your wishlist is empty"
            android:textColor="#0D3238"
            android:textSize="18sp"
            app:carbon_font="@font/space_grotesk_semibold" />
    </LinearLayout>

</carbon.widget.RelativeLayout>