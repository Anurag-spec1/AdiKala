<?xml version="1.0" encoding="utf-8"?>
<carbon.widget.RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg"
    android:fitsSystemWindows="true"
    tools:context=".view.fragment.OrdersFragment">

    <ProgressBar
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_centerInParent="true"
        android:id="@+id/progressBar"/>

    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <carbon.widget.TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Orders"
                android:textColor="#0D3238"
                android:textSize="28sp"
                app:carbon_font="@font/space_grotesk_semibold" />

            <carbon.widget.TextView
                android:id="@+id/tvHeaderSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:text="Track and manage your purchases"
                android:textColor="@color/carbon_grey_700"
                android:textSize="14sp"
                app:carbon_font="@font/space_grotesk_semibold" />
        </LinearLayout>

        <carbon.widget.ImageView
            android:id="@+id/btnHelp"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:layout_marginVertical="3dp"
            android:src="@drawable/ic_help"
            app:carbon_cornerRadius="23dp"
            app:carbon_elevation="4dp"
            app:carbon_rippleColor="#1A0D3238"
            app:carbon_stroke="#14000000"
            app:carbon_strokeWidth="1dp"
            app:carbon_tint="#0D3238" />
    </LinearLayout>

    <carbon.widget.LinearLayout
        android:id="@+id/segmentBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/headerRow"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:padding="6dp"
        app:carbon_cornerRadius="28dp"
        app:carbon_elevation="5dp"
        app:carbon_elevationShadowColor="@color/carbon_grey_500"
        app:carbon_stroke="#14000000"
        app:carbon_strokeWidth="1dp">

        <carbon.widget.LinearLayout
            android:id="@+id/tabOngoing"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#0D3238"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            app:carbon_cornerRadius="22dp"
            app:carbon_elevation="3dp"
            app:carbon_rippleColor="#40FFFFFF">

            <carbon.widget.TextView
                android:id="@+id/tvTabOngoing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ongoing"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:carbon_font="@font/space_grotesk_semibold" />

            <carbon.widget.TextView
                android:id="@+id/tvCountOngoing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:background="#33FFFFFF"
                android:gravity="center"
                android:minWidth="22dp"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:carbon_cornerRadius="11dp"
                app:carbon_font="@font/space_grotesk_semibold" />
        </carbon.widget.LinearLayout>

        <carbon.widget.LinearLayout
            android:id="@+id/tabPast"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            app:carbon_cornerRadius="22dp"
            app:carbon_rippleColor="#1A0D3238">

            <carbon.widget.TextView
                android:id="@+id/tvTabPast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Past"
                android:textColor="#8A8A8A"
                android:textSize="15sp"
                app:carbon_font="@font/space_grotesk_semibold" />

            <carbon.widget.TextView
                android:id="@+id/tvCountPast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:background="#14000000"
                android:gravity="center"
                android:minWidth="22dp"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="0"
                android:textColor="#8A8A8A"
                android:textSize="12sp"
                app:carbon_cornerRadius="11dp"
                app:carbon_font="@font/space_grotesk_semibold" />
        </carbon.widget.LinearLayout>
    </carbon.widget.LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOrders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/segmentBar"
        android:layout_marginTop="18dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="100dp"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/segmentBar"
        android:layout_centerInParent="true"
        android:layout_marginTop="120dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <carbon.widget.RelativeLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@color/white"
            app:carbon_cornerRadius="60dp"
            app:carbon_elevation="6dp"
            app:carbon_elevationShadowColor="@color/carbon_grey_500"
            app:carbon_stroke="#e9bdb0"
            app:carbon_strokeWidth="1.5dp">

            <carbon.widget.ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_centerInParent="true"
                android:alpha="0.55"
                android:src="@drawable/ic_box"
                app:carbon_tint="#0D3238" />
        </carbon.widget.RelativeLayout>

        <carbon.widget.TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="No ongoing orders"
            android:textColor="#0D3238"
            android:textSize="20sp"
            app:carbon_font="@font/space_grotesk_semibold" />

        <carbon.widget.TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Your active orders will show up here"
            android:textColor="@color/carbon_grey_700"
            android:textSize="14sp"
            app:carbon_font="@font/space_grotesk_semibold" />

        <carbon.widget.LinearLayout
            android:id="@+id/btnShopNow"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:background="#0D3238"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            app:carbon_cornerRadius="24dp"
            app:carbon_elevation="4dp"
            app:carbon_rippleColor="#40FFFFFF">

            <carbon.widget.TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Shopping"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:carbon_font="@font/space_grotesk_semibold" />
        </carbon.widget.LinearLayout>
    </LinearLayout>


    <carbon.widget.RelativeLayout
        android:id="@+id/helpCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/segmentBar"
        android:layout_marginHorizontal="16dp"
        android:background="@color/white"
        android:padding="20dp"
        android:layout_marginTop="70dp"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:carbon_cornerRadius="24dp"
        app:carbon_elevation="6dp"
        app:carbon_elevationShadowColor="@color/carbon_grey_500"
        app:carbon_stroke="#14000000"
        app:carbon_strokeWidth="1dp">

        <carbon.widget.ImageView
            android:id="@+id/btnCloseHelp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:carbon_cornerRadius="16dp"
            app:carbon_elevation="2dp"
            app:carbon_tint="#0D3238" />

        <carbon.widget.TextView
            android:id="@+id/tvHelpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btnCloseHelp"
            android:text="How Orders Work"
            android:textColor="#0D3238"
            android:textSize="20sp"
            app:carbon_font="@font/space_grotesk_semibold" />

        <carbon.widget.TextView
            android:id="@+id/tvHelpSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvHelpTitle"
            android:layout_alignParentStart="true"
            android:layout_marginTop="4dp"
            android:text="Track your order from placement to delivery"
            android:textColor="#8A8A8A"
            android:textSize="13sp"
            app:carbon_font="@font/space_grotesk_semibold" />

        <LinearLayout
            android:id="@+id/statusList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvHelpSubtitle"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_status_line"
                    android:backgroundTint="#3F6076" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <carbon.widget.TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirmed"
                        android:textColor="#0D3238"
                        android:textSize="15sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <carbon.widget.TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order placed successfully"
                        android:textColor="#8A8A8A"
                        android:textSize="12sp"
                        app:carbon_font="@font/space_grotesk_semibold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_status_line"
                    android:backgroundTint="#6B4A8A" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <carbon.widget.TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Processing"
                        android:textColor="#0D3238"
                        android:textSize="15sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <carbon.widget.TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Being packed and prepared"
                        android:textColor="#8A8A8A"
                        android:textSize="12sp"
                        app:carbon_font="@font/space_grotesk_semibold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_status_line"
                    android:backgroundTint="#2E6B9E" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <carbon.widget.TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shipped"
                        android:textColor="#0D3238"
                        android:textSize="15sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <carbon.widget.TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Handed to courier partner"
                        android:textColor="#8A8A8A"
                        android:textSize="12sp"
                        app:carbon_font="@font/space_grotesk_semibold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_status_line"
                    android:backgroundTint="#C97B4A" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <carbon.widget.TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Out for Delivery"
                        android:textColor="#0D3238"
                        android:textSize="15sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <carbon.widget.TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arriving at your address"
                        android:textColor="#8A8A8A"
                        android:textSize="12sp"
                        app:carbon_font="@font/space_grotesk_semibold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_status_line"
                    android:backgroundTint="#4A6B5A" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <carbon.widget.TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivered"
                        android:textColor="#0D3238"
                        android:textSize="15sp"
                        app:carbon_font="@font/space_grotesk_semibold" />

                    <carbon.widget.TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Successfully delivered"
                        android:textColor="#8A8A8A"
                        android:textSize="12sp"
                        app:carbon_font="@font/space_grotesk_semibold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/statusList"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#F2F2F2" />

        <carbon.widget.TextView
            android:id="@+id/tvTrackerInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/divider"
            android:text="Placed → Packed → Shipped → Delivered"
            android:textColor="#8A8A8A"
            android:textSize="11sp"
            android:gravity="center"
            app:carbon_font="@font/space_grotesk_semibold" />

    </carbon.widget.RelativeLayout>

</carbon.widget.RelativeLayout>