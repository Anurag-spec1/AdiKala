<?xml version="1.0" encoding="utf-8"?>

<carbon.widget.LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chipFilter"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:layout_marginBottom="5dp"
    android:layout_marginEnd="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="18dp"
    android:paddingEnd="14dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@android:color/white"
    android:foreground="?attr/selectableItemBackground"
    android:stateListAnimator="@null"
    app:carbon_cornerRadius="22dp"
    app:carbon_elevation="3dp"
    app:carbon_strokeWidth="1dp"
    app:carbon_stroke="@color/carbon_grey_200">

    <carbon.widget.TextView
        android:id="@+id/tvChipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="Temple"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:singleLine="true"
        android:ellipsize="end"
        app:carbon_font="@font/space_grotesk_semibold"/>

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/carbon_grey_400"/>

</carbon.widget.LinearLayout>