<?xml version="1.0" encoding="utf-8"?>
<carbon.widget.LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFilter"
    android:layout_width="100dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="8dp"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="9dp"
    android:paddingVertical="16dp"
    android:background="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@null"
    app:carbon_cornerRadius="18dp"
    app:carbon_elevation="3dp"
    app:carbon_stroke="#14000000"
    app:carbon_strokeWidth="1dp">


    <carbon.widget.FrameLayout
        android:layout_width="51dp"
        android:layout_height="51dp"
        android:background="#EEF7F7"
        app:carbon_cornerRadius="9dp">

        <carbon.widget.ImageView
            android:id="@+id/ivCategory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"/>
    </carbon.widget.FrameLayout>

    <carbon.widget.TextView
        android:id="@+id/tvChipLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:gravity="center"
        android:text="Temple"
        android:textColor="#16353A"
        android:textSize="16sp"
        app:carbon_font="@font/space_grotesk_semibold"
        android:maxLines="2"
        android:ellipsize="end"/>

</carbon.widget.LinearLayout>