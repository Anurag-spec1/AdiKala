<?xml version="1.0" encoding="utf-8"?>

<carbon.widget.LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFilter"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true"
    android:background="@android:color/transparent"
    android:stateListAnimator="@null">

    <carbon.widget.RelativeLayout
        android:id="@+id/iconContainer"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@android:color/white"
        app:carbon_cornerRadius="30dp"
        app:carbon_strokeWidth="2dp"
        app:carbon_stroke="#0D3238">

        <carbon.widget.TextView
            android:id="@+id/tvAvatarLetter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="T"
            android:textColor="#0D3238"
            android:textSize="25sp"
            app:carbon_font="@font/space_grotesk_semibold"/>

    </carbon.widget.RelativeLayout>

    <carbon.widget.TextView
        android:id="@+id/tvChipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Temple"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        app:carbon_font="@font/space_grotesk_semibold"/>

</carbon.widget.LinearLayout>