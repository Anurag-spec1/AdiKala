<?xml version="1.0" encoding="utf-8"?>

<carbon.widget.LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:orientation="vertical"
    android:background="@android:color/white"
    app:carbon_cornerRadius="20dp"
    app:carbon_elevation="4dp"
    app:carbon_strokeWidth="1dp"
    app:carbon_stroke="@color/carbon_grey_300">

    <carbon.widget.ImageView
        android:id="@+id/imgPlace"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        android:src="@drawable/sample_place"
        app:carbon_cornerRadiusTopEnd="20dp"
        app:carbon_cornerRadiusTopStart="20dp"/>

    <carbon.widget.TextView
        android:id="@+id/tvPlaceName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:text="Varanasi"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        app:carbon_font="@font/space_grotesk_semibold"/>

</carbon.widget.LinearLayout>