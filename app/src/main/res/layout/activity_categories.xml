<?xml version="1.0" encoding="utf-8"?>
<carbon.widget.RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg"
    android:fitsSystemWindows="true"
    tools:context=".view.activity.CategoriesActivity">

    <carbon.widget.ImageView
        android:id="@+id/btnBack"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        android:background="@color/white"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chevron_left"
        app:carbon_cornerRadius="22.5dp"
        app:carbon_elevation="4dp"
        app:carbon_rippleColor="#1A0D3238"
        app:carbon_stroke="#e9bdb0"
        app:carbon_strokeWidth="1.5dp"
        app:carbon_tint="#0D3238" />

    <LinearLayout
        android:id="@+id/titleWrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/btnBack"
        android:layout_alignBottom="@id/btnBack"
        android:layout_toEndOf="@id/btnBack"
        android:layout_marginStart="14dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <carbon.widget.TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Browse"
            android:textColor="@color/carbon_grey_700"
            android:textSize="13sp"
            app:carbon_font="@font/space_grotesk_semibold" />

        <carbon.widget.TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-3dp"
            android:text="All Categories"
            android:id="@+id/tvTitle"
            android:textColor="#0D3238"
            android:textSize="22sp"
            app:carbon_font="@font/space_grotesk_semibold" />
    </LinearLayout>

    <carbon.widget.TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnBack"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:text="Explore our full collection"
        android:textColor="@color/carbon_grey_700"
        android:textSize="14sp"
        app:carbon_font="@font/space_grotesk_semibold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvSubtitle"
        android:layout_marginTop="14dp">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            app:shimmer_auto_start="true"
            app:shimmer_duration="1200">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="4dp">

                <include layout="@layout/shimmer_category_card" />
                <include layout="@layout/shimmer_category_card" />
                <include layout="@layout/shimmer_category_card" />
                <include layout="@layout/shimmer_category_card" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            android:scrollbars="none"
            tools:listitem="@layout/item_category_grid" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvSubtitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <carbon.widget.ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:alpha="0.5"
            android:src="@drawable/ic_box"
            app:carbon_tint="@color/carbon_grey_500" />

        <carbon.widget.TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="No categories yet"
            android:textColor="#0D3238"
            android:textSize="18sp"
            app:carbon_font="@font/space_grotesk_semibold" />
    </LinearLayout>

</carbon.widget.RelativeLayout>