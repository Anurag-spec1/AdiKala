<?xml version="1.0" encoding="utf-8"?>
<carbon.widget.LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <carbon.widget.TextView
            android:id="@+id/tvReviewerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reviewer Name"
            android:textColor="#0D3238"
            android:textSize="15sp"
            app:carbon_font="@font/space_grotesk_semibold" />

        <carbon.widget.TextView
            android:id="@+id/tvVerified"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E7F0EA"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="✓ Verified"
            android:textColor="#4A6B5A"
            android:textSize="11sp"
            android:visibility="gone"
            app:carbon_cornerRadius="8dp"
            app:carbon_font="@font/space_grotesk_semibold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <carbon.widget.ImageView
            android:id="@+id/star1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_star"
            app:carbon_tint="#E0E0E0" />

        <carbon.widget.ImageView
            android:id="@+id/star2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_star"
            app:carbon_tint="#E0E0E0" />

        <carbon.widget.ImageView
            android:id="@+id/star3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_star"
            app:carbon_tint="#E0E0E0" />

        <carbon.widget.ImageView
            android:id="@+id/star4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_star"
            app:carbon_tint="#E0E0E0" />

        <carbon.widget.ImageView
            android:id="@+id/star5"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_star"
            app:carbon_tint="#E0E0E0" />
    </LinearLayout>

    <carbon.widget.TextView
        android:id="@+id/tvReviewTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Review Title"
        android:textColor="#0D3238"
        android:textSize="15sp"
        app:carbon_font="@font/space_grotesk_semibold" />

    <carbon.widget.TextView
        android:id="@+id/tvReviewBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:text="Review body text"
        android:textColor="#5C5C5C"
        android:textSize="14sp"
        app:carbon_font="@font/space_grotesk_semibold" />

    <carbon.widget.ImageView
        android:id="@+id/ivReviewPhoto"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:carbon_cornerRadius="10dp" />

    <carbon.widget.TextView
        android:id="@+id/tvReviewDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Date"
        android:textColor="#9B9B9B"
        android:textSize="12sp"
        app:carbon_font="@font/space_grotesk_semibold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/line" />
</carbon.widget.LinearLayout>