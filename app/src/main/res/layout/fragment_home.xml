<?xml version="1.0" encoding="utf-8"?>
<carbon.widget.RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/main_bg"
    tools:context=".view.fragment.HomeFragment">

    <carbon.widget.ImageView
        android:id="@+id/userImg"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        android:scaleType="centerCrop"
        android:src="@drawable/user_image"
        app:carbon_cornerRadius="30dp"
        app:carbon_elevation="3dp"
        app:carbon_stroke="@color/carbon_blue_200"
        app:carbon_strokeWidth="1dp" />

    <LinearLayout
        android:id="@+id/userInfoLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/userImg"
        android:layout_alignBottom="@id/userImg"
        android:layout_marginStart="11dp"
        android:layout_toEndOf="@id/userImg"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <carbon.widget.TextView
            android:id="@+id/gestureTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Good Morning !"
            android:textColor="@color/carbon_grey_700"
            android:textSize="16sp"
            app:carbon_font="@font/space_grotesk_semibold" />

        <carbon.widget.TextView
            android:id="@+id/userName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:maxLines="1"
            android:text="Anurag"
            android:textColor="#0D3238"
            android:textSize="21sp"
            app:carbon_font="@font/space_grotesk_semibold" />

    </LinearLayout>

    <carbon.widget.ImageView
        android:id="@+id/cart"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="15dp"
        android:background="@color/white"
        android:clickable="true"
        android:focusable="true"
        android:padding="13dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_cart"
        app:carbon_cornerRadius="22.5dp"
        app:carbon_elevation="4dp"
        app:carbon_elevationShadowColor="@color/black"
        app:carbon_stroke="#14000000"
        app:carbon_strokeWidth="1dp"
        app:carbon_tint="#0D3238" />

    <carbon.widget.ImageView
        android:id="@+id/notification"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="15dp"
        android:layout_toStartOf="@id/cart"
        android:background="@color/white"
        android:clickable="true"
        android:focusable="true"
        android:padding="13dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_notification"
        app:carbon_cornerRadius="22.5dp"
        app:carbon_elevation="4dp"
        app:carbon_elevationShadowColor="@color/black"
        app:carbon_stroke="#14000000"
        app:carbon_strokeWidth="1dp"
        app:carbon_tint="#0D3238" />

    <carbon.widget.ImageView
        android:id="@+id/ivMic"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_below="@id/userImg"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="20dp"
        android:background="#0D3238"
        android:clickable="true"
        android:focusable="true"
        android:scaleType="center"
        android:src="@drawable/ic_mic"
        app:carbon_cornerRadius="30dp"
        app:carbon_elevation="4dp"
        app:carbon_stroke="@color/carbon_grey_300"
        app:carbon_strokeWidth="1dp"
        app:carbon_tint="@color/white" />

    <carbon.widget.EditText
        android:id="@+id/etSearchBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_below="@id/userImg"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@id/ivMic"
        android:background="@android:color/white"
        android:clickable="true"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:drawableTint="#0D3238"
        android:focusable="true"
        android:gravity="center_vertical"
        android:hint="Search handcrafts..."
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:singleLine="true"
        android:textColor="@android:color/black"
        android:textColorHint="#8A8A8A"
        android:textSize="16sp"
        app:carbon_cornerRadius="30dp"
        app:carbon_elevation="4dp"
        app:carbon_font="@font/space_grotesk_semibold"
        app:carbon_stroke="#14000000"
        app:carbon_strokeWidth="1dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/etSearchBar"
        android:layout_marginTop="20dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <carbon.widget.ImageView
                android:id="@+id/bannerImg"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginHorizontal="20dp"
                android:focusable="true"
                android:scaleType="fitXY"
                android:src="@drawable/home_banner"
                app:carbon_cornerRadius="18dp"
                app:carbon_elevation="4dp"
                app:carbon_elevationShadowColor="@color/black"
                app:carbon_stroke="#e9bdb0"
                app:carbon_strokeWidth="1.5dp" />

            <carbon.widget.LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <carbon.widget.TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="15dp"
                    android:text="Categories"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#0D3238"
                    android:textSize="22sp"
                    app:carbon_font="@font/space_grotesk_semibold" />

                <carbon.widget.TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/viewallCategories"
                    android:textSize="14sp"
                    android:gravity="top"
                    app:carbon_font="@font/space_grotesk_semibold"
                    android:text="View all →"
                    android:layout_marginEnd="15dp"
                    android:layout_marginTop="15dp"
                    android:textColor="@color/carbon_blue_700"/>

            </carbon.widget.LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:shimmer_auto_start="true"
                    app:shimmer_duration="1200">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <View
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/shimmer_placeholder" />

                        <View
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/shimmer_placeholder" />

                        <View
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/shimmer_placeholder" />

                        <View
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@drawable/shimmer_placeholder" />
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />
            </FrameLayout>

            <carbon.widget.LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <carbon.widget.TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="15dp"
                    android:text="New Arrivals"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#0D3238"
                    android:textSize="22sp"
                    app:carbon_font="@font/space_grotesk_semibold" />

            </carbon.widget.LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="5dp"
                android:paddingBottom="80dp">

                 <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerPopular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:shimmer_auto_start="true"
                    app:shimmer_duration="1200">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="400dp"
                        android:orientation="vertical"
                        android:paddingTop="7dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/shimmer_placeholder" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/shimmer_placeholder" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/shimmer_placeholder" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/shimmer_placeholder" />
                        </LinearLayout>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPopular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingTop="7dp"
                    tools:listitem="@layout/item_popular_collection" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</carbon.widget.RelativeLayout>