<?xml version="1.0" encoding="utf-8"?>
<carbon.widget.RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E2EDE5"
    android:fitsSystemWindows="true"
    tools:context=".fragment.HomeFragment">

    <carbon.widget.ImageView
        android:id="@+id/userImg"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        android:scaleType="centerCrop"
        android:src="@drawable/user_image"
        app:carbon_cornerRadius="30dp"
        app:carbon_elevation="3dp"
        app:carbon_stroke="@color/carbon_blue_200"
        app:carbon_strokeWidth="1dp" />

    <LinearLayout
        android:id="@+id/userInfoLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/userImg"
        android:layout_marginStart="15dp"
        android:layout_alignTop="@id/userImg"
        android:layout_alignBottom="@id/userImg"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <carbon.widget.TextView
            android:id="@+id/gestureTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Good Morning !"
            android:textColor="@color/carbon_grey_700"
            android:textSize="15sp"
            app:carbon_font="@font/space_grotesk_semibold" />

        <carbon.widget.TextView
            android:id="@+id/userName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Anurag"
            android:textColor="@color/black"
            android:textSize="22sp"
            app:carbon_font="@font/space_grotesk_semibold" />

    </LinearLayout>


    <carbon.widget.ImageView
        android:id="@+id/cart"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="15dp"
        android:background="@color/white"
        android:focusable="true"
        android:clickable="true"
        android:padding="13dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_cart"
        app:carbon_elevationShadowColor="@color/black"
        app:carbon_cornerRadius="22.5dp"
        app:carbon_elevation="4dp"
        app:carbon_tint="@color/carbon_grey_700" />

    <carbon.widget.ImageView
        android:id="@+id/notification"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="15dp"
        android:focusable="true"
        android:layout_toStartOf="@id/cart"
        android:background="@color/white"
        android:clickable="true"
        android:padding="13dp"
        app:carbon_elevationShadowColor="@color/black"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_notification"
        app:carbon_cornerRadius="22.5dp"
        app:carbon_elevation="4dp"
        app:carbon_tint="@color/carbon_grey_700" />

    <carbon.widget.EditText
        android:id="@+id/etSearchBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_below="@id/userImg"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="84dp"
        android:background="@android:color/white"
        android:hint="Search destination..."
        android:textColor="@android:color/black"
        android:textColorHint="#8A8A8A"
        android:textSize="18sp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:drawableTint="@android:color/black"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:maxLines="1"
        android:inputType="text"
        android:imeOptions="actionSearch"
        app:carbon_font="@font/space_grotesk_semibold"
        app:carbon_cornerRadius="30dp"
        app:carbon_strokeWidth="1dp"
        app:carbon_stroke="@color/carbon_grey_300"
        app:carbon_elevation="4dp" />

    <carbon.widget.ImageView
        android:id="@+id/ivMic"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignTop="@id/etSearchBar"
        android:layout_alignBottom="@id/etSearchBar"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="15dp"
        android:background="@color/black"
        android:src="@drawable/ic_mic"
        android:scaleType="center"
        app:carbon_tint="@color/white"
        android:clickable="true"
        android:focusable="true"
        app:carbon_cornerRadius="30dp"
        app:carbon_strokeWidth="1dp"
        app:carbon_stroke="@color/carbon_grey_300"
        app:carbon_elevation="4dp"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/etSearchBar"
        android:fillViewport="true"
        android:layout_marginTop="20dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <carbon.widget.ImageView
                android:id="@+id/bannerImg"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="@drawable/home_banner"
                app:carbon_cornerRadius="20dp"
                app:carbon_elevation="4dp"
                app:carbon_strokeWidth="1dp"
                app:carbon_stroke="@color/carbon_grey_300"
                android:layout_marginTop="10dp"
                app:carbon_elevationShadowColor="@color/black"
                android:focusable="true"
                android:scaleType="fitXY"
                android:layout_marginHorizontal="20dp"/>

            <carbon.widget.TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:text="Categories"
                android:textColor="@android:color/black"
                android:textSize="22sp"
                app:carbon_font="@font/space_grotesk_semibold"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                tools:listitem="@layout/item_category"
                android:nestedScrollingEnabled="false"/>

            <carbon.widget.TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="Popular Collections"
                android:textColor="@android:color/black"
                android:textSize="22sp"
                app:carbon_font="@font/space_grotesk_semibold"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPopular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                tools:listitem="@layout/item_popular_collection"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="20dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>





</carbon.widget.RelativeLayout>